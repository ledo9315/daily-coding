# Goes to /opt/daily-coding/.env on the host, readable by root only.
#
# Everything here is read when the container starts. The NEXT_PUBLIC_* variables are NOT
# here: Next inlines them into the browser bundle during `next build`, so they are build
# arguments in the GitHub workflow instead.

# The host stays `piston.daily-coding.de`, because the certificate Postgres presents is
# Caddy's and carries that one name; `verify-full` rejects every other, the container's
# included. It no longer leaves the machine for it: the database container answers to that
# same name as a network alias on the shared Docker network (see deploy/README.md), so the
# connection is container to container and 5432 is closed to the internet.
#
# The name here is DATABASE_URL, not APP_DATABASE_URL: that split only existed because the
# Neon integration owned DATABASE_URL on Vercel and locked it. Nothing locks it here, and
# `prisma migrate deploy` reads DATABASE_URL, while the app falls back to it anyway
# (lib/server/database-url.ts).
DATABASE_URL=

AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://daily-coding.dev
APP_URL=https://daily-coding.dev

# The systemd timer reads this file too, so the reminder and the route cannot drift apart.
CRON_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=true

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# NOT piston.daily-coding.de, although Caddy serves Piston under that name too. The
# database container answers to that name as a network alias (see deploy/README.md), so
# inside the app container it resolves to Postgres and every submission fails with
# "Execution failed: fetch failed". Caddy's site block carries both names; this is the
# other one, and it has no alias pointing at it.
#
# The request still leaves the machine and comes back through Caddy, which is wasteful but
# works; Piston listens on 127.0.0.1 only and was started outside compose, so a container
# cannot reach it directly.
PISTON_API_URL=https://piston.leonid-domahalskyy.de
PISTON_API_TOKEN=
CODE_EXECUTION_ENABLED=true

# The server half of Sentry. The browser half is baked in at build time.
SENTRY_DSN=
