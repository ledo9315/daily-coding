// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Difficulty {
  easy
  medium
  hard
}

enum SubmissionStatus {
  pending
  completed
  failed
  skipped
}

enum RankingPeriod {
  week
  month
}

enum AchievementRarity {
  common
  rare
  epic
  legendary
}

enum UserRole {
  user
  admin
}

/// Interface language of a user. Values match the message directories under `messages/`.
enum Locale {
  de
  en
}

/// Programming languages available for daily challenges (extend as runners are added).
/// The two ways a solution can be praised (#225).
enum SolutionVoteKind {
  best_practices
  clever
}

/// What happened at a solution: a comment, or one of the two ways it can be praised (#257).
enum NotificationKind {
  comment
  best_practices
  clever
}

enum CodeLanguage {
  javascript
  typescript
  python
  php
  java
  ruby
  go
  cpp
  csharp
  rust
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  name         String
  /// Lower-cased `name` with collapsed whitespace; carries the uniqueness (#107).
  nameKey      String       @unique
  initials     String
  avatar       String
  email        String       @unique
  passwordHash String?
  emailVerified Boolean  @default(false)
  accounts      Account[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  role         UserRole     @default(user)

  /// Opt-out for activity mails; the in-app bell is not affected by it (#257).
  notifyByEmail Boolean     @default(true)

  /// Opt-out for the daily reminder, kept apart from `notifyByEmail` (#288). Hearing about
  /// a comment on your solution and wanting a nudge every morning are two decisions, and
  /// one switch for both would make the quieter of the two impossible.
  notifyDailyReminder Boolean @default(true)

  /// When the last reminder actually went out. The cron may run twice on a day - a retry,
  /// a manual trigger - and this is what keeps the second run silent.
  dailyReminderSentAt DateTime?

  /// Interface and mail language. `de` for every existing row: the app has always been
  /// German, and a default of `en` would take the language away from them overnight (E7).
  /// A mail is sent without a request, so there is no cookie to read - this column is the
  /// only place the language of a mail can come from.
  locale        Locale      @default(de)

  streak       Int          @default(0)
  streakRecord Int          @default(0)
  submissions    Submission[]
  comments       Comment[]
  solutionVotes  SolutionVote[]
  achievements   UserAchievement[]
  rankingEntries RankingEntry[]
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AchievementDef {
  id           String            @id @default(cuid())
  title        String
  description  String
  iconKey      String
  rarity       AchievementRarity @default(common)
  userProgress UserAchievement[]
  translations AchievementTranslation[]
  createdAt    DateTime          @default(now())
}

/// Title and description of one achievement in one language.
///
/// The `AchievementDef` columns keep the German original and stay the fallback: a locale
/// without a row here is answered with them, so a half-translated catalogue shows German
/// rather than a gap (E8).
model AchievementTranslation {
  achievementId String
  locale        Locale
  title         String
  description   String
  achievement   AchievementDef @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([achievementId, locale])
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime?
  user          User           @relation(fields: [userId], references: [id])
  achievement   AchievementDef @relation(fields: [achievementId], references: [id])
  createdAt     DateTime       @default(now())

  @@id([userId, achievementId])
}

model Category {
  id           String      @id @default(cuid())
  name         String      @unique
  challenges   Challenge[]
  translations CategoryTranslation[]
  createdAt    DateTime    @default(now())
}

/// The name of one category in one language.
///
/// A table of its own rather than a second name column: `Category.name` is `@unique`, so a
/// translation written into it would collide with the German name it translates.
model CategoryTranslation {
  categoryId String
  locale     Locale
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
}

model Challenge {
  id          String       @id @default(cuid())
  title       String
  description String
  difficulty  Difficulty
  points      Int
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  /// Staged hints, unfolded one at a time: [{ "title": "Die Idee", "body": "…" }]
  hints       Json         @default("[]")
  examples    Json         @default("[]")
  testCases   Json         @default("[]")
  /// Optional: { "callableByLanguage": { "javascript": "fn", "typescript": "fn", "python": "sn_fn", "php": "fn" } } for stdin/stdout grading
  evaluationConfig Json?
  /// @deprecated Prefer starterCodes; kept for seeds / legacy rows.
  starterCode String?
  /// All languages users may submit in for this challenge.
  supportedLanguages CodeLanguage[] @default([javascript, typescript, python, php])
  /// Map language id -> starter template (JSON object).
  starterCodes Json @default("{}")
  isActive    Boolean      @default(false)
  /// Place in the daily ring. Not unique: swapping two rows would collide mid-transaction,
  /// and ties are broken by id anyway (`compareRingEntries`).
  position    Int          @default(0)
  /// @deprecated Superseded by `position`. The ring has no dates; kept for one release so the
  /// old schedule can be read back if the rollout goes wrong.
  date        DateTime?    @unique
  submissions Submission[]
  solutionVotes SolutionVote[]
  notifications Notification[]
  translations ChallengeTranslation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// The prose of one challenge in one language: everything a solver reads, nothing the
/// grader needs. Test inputs, expected values, points and starter code have no language.
///
/// The `Challenge` columns keep the German original and stay the fallback: a locale without
/// a row here is answered with them, so an untranslated challenge shows German text instead
/// of an empty page (E8).
model ChallengeTranslation {
  challengeId   String
  locale        Locale
  title         String
  description   String
  hints         Json
  /// Test-case names, keyed by `testCases[].id` - not by position, so reordering the test
  /// cases does not shift the names onto the wrong cases.
  testCaseNames Json
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, locale])
}

/// Where the daily ring currently stands. Exactly one row, id "current".
///
/// Stored rather than computed: `dayNumber % poolSize` is part formula, part pool size, so it
/// jumped every time a challenge was added or deactivated. With the position visible in the
/// admin panel that jump would look like a bug. The row moves on the first request of a new UTC
/// day, which is why no cron job is involved.
model RotationState {
  id          String   @id @default("current")
  /// The challenge that is live. Null only before the first advance.
  challengeId String?
  /// Position of that challenge, so the ring can continue at the right gap if it disappears.
  position    Int      @default(0)
  /// Start of the UTC day `challengeId` became live.
  day         DateTime
  updatedAt   DateTime @updatedAt
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  code        String
  language    CodeLanguage     @default(javascript)
  status      SubmissionStatus @default(pending)
  rank        Int?
  testResults Json?
  /// UTC day reserved for the one-attempt constraint. Legacy rows are backfilled with createdAt.
  submissionDay DateTime
  /// SHA-256 over the normalized code, the key identical solutions are grouped by (#223).
  /// Nullable only for rows written before the column existed; the backfill script fills them.
  codeHash    String?
  user        User             @relation(fields: [userId], references: [id])
  challenge   Challenge        @relation(fields: [challengeId], references: [id])
  comments    Comment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, submissionDay])
  @@index([challengeId, codeHash])
}

/// One user's praise for one *solution*, which is a piece of code, not a submission row.
///
/// The key is the code hash on purpose: a re-submission overwrites the row of the day (#200),
/// so a vote tied to the submission would silently move to code the voter never saw.
model SolutionVote {
  id          String           @id @default(cuid())
  challengeId String
  codeHash    String
  userId      String
  kind        SolutionVoteKind
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([challengeId, codeHash, userId, kind])
  @@index([challengeId, codeHash])
}

/// A remark under one submission. Both cascades are needed: deleting an account removes the
/// submissions it wrote in an explicit transaction, and a comment left under someone else's
/// solution has to go with its author.
model Comment {
  id           String     @id @default(cuid())
  submissionId String
  userId       String
  body         String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([submissionId, createdAt])
}

/// Activity at one solution, addressed to one of its authors (#257).
///
/// Points at `(challengeId, codeHash)` for the same reason `SolutionVote` does: the thread and
/// the votes belong to a piece of code, not to the submission row that happens to carry them.
/// Nothing of the message is stored - the text is built from `kind` and the actor when read,
/// so a renamed user is not quoted under the old name forever.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  actorId     String
  kind        NotificationKind
  challengeId String
  codeHash    String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** Shared across serverless instances; keys are SHA-256 hashes, never raw emails or IPs. */
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model RankingEntry {
  id               String        @id @default(cuid())
  period           RankingPeriod
  rank             Int
  previousRank     Int?
  points           Int
  challengesSolved Int?
  periodDate       DateTime
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([userId, period, periodDate])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
