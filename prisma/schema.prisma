// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Difficulty {
  easy
  medium
  hard
}

enum SubmissionStatus {
  pending
  completed
  failed
  skipped
}

enum RankingPeriod {
  today
  week
  month
}

enum AchievementRarity {
  common
  rare
  epic
  legendary
}

enum UserRole {
  user
  admin
}

/// Programming languages available for daily challenges (extend as runners are added).
enum CodeLanguage {
  javascript
  typescript
  python
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  name         String
  initials     String
  avatar       String
  email        String       @unique
  passwordHash String?
  role         UserRole     @default(user)

  streak       Int          @default(0)
  streakRecord Int          @default(0)
  submissions    Submission[]
  achievements   UserAchievement[]
  rankingEntries RankingEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AchievementDef {
  id           String            @id @default(cuid())
  title        String
  description  String
  iconKey      String
  rarity       AchievementRarity @default(common)
  userProgress UserAchievement[]
  createdAt    DateTime          @default(now())
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime?
  user          User           @relation(fields: [userId], references: [id])
  achievement   AchievementDef @relation(fields: [achievementId], references: [id])
  createdAt     DateTime       @default(now())

  @@id([userId, achievementId])
}

model Category {
  id         String      @id @default(cuid())
  name       String      @unique
  challenges Challenge[]
  createdAt  DateTime    @default(now())
}

model Challenge {
  id          String       @id @default(cuid())
  title       String
  description String
  difficulty  Difficulty
  points      Int
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  hint        String?
  examples    Json         @default("[]")
  testCases   Json         @default("[]")
  /// Optional: { "callableByLanguage": { "javascript": "fn", "typescript": "fn", "python": "sn_fn" } } für stdin/stdout-Auswertung
  evaluationConfig Json?
  /// @deprecated Prefer starterCodes; kept for seeds / legacy rows.
  starterCode String?
  /// All languages users may submit in for this challenge.
  supportedLanguages CodeLanguage[] @default([javascript, typescript, python])
  /// Map language id → starter template (JSON object).
  starterCodes Json @default("{}")
  isActive    Boolean      @default(false)
  date        DateTime?    @unique
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  code        String
  language    CodeLanguage     @default(javascript)
  status      SubmissionStatus @default(pending)
  timeTaken   Int?
  rank        Int?
  testResults Json?
  user        User             @relation(fields: [userId], references: [id])
  challenge   Challenge        @relation(fields: [challengeId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RankingEntry {
  id               String        @id @default(cuid())
  period           RankingPeriod
  rank             Int
  previousRank     Int?
  points           Int
  challengesSolved Int?
  timeTaken        Int?
  periodDate       DateTime
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([userId, period, periodDate])
}
