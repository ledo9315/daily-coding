// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  invited
  inactive
}

enum Difficulty {
  easy
  medium
  hard
}

enum SubmissionStatus {
  pending
  completed
  failed
  skipped
}

enum RankingPeriod {
  today
  week
  month
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  name         String
  initials     String
  avatar       String
  email        String       @unique
  role         String       @default("Mitglied")
  status       UserStatus   @default(active)
  department   String?
  joinDate     DateTime?
  level        Int          @default(1)
  points       Int          @default(0)
  streak       Int          @default(0)
  streakRecord Int          @default(0)
  totalSolved  Int          @default(0)
  badges       Int          @default(0)
  submissions  Submission[]
  achievements Achievement[]
  rankingEntries RankingEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  iconKey     String
  unlocked    Boolean  @default(false)
  rarity      String   @default("common")
  unlockedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Challenge {
  id          String       @id @default(cuid())
  title       String
  description String
  difficulty  Difficulty
  points      Int
  category    String
  hint        String?
  examples    Json         @default("[]")
  testCases   Json         @default("[]")
  starterCode String?
  isActive    Boolean      @default(false)
  date        DateTime?    @unique
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  code        String
  status      SubmissionStatus @default(pending)
  timeTaken   Int?
  rank        Int?
  testResults Json?
  user        User             @relation(fields: [userId], references: [id])
  challenge   Challenge        @relation(fields: [challengeId], references: [id])
  createdAt   DateTime         @default(now())
}

model RankingEntry {
  id               String        @id @default(cuid())
  period           RankingPeriod
  rank             Int
  previousRank     Int?
  points           Int
  challengesSolved Int?
  timeTaken        String?
  periodDate       DateTime
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([userId, period, periodDate])
}
