# Lokal: Postgres in Docker (Port 5433). Vorher: docker compose up -d db
DATABASE_URL=postgresql://daily_dev:daily_dev_secret@localhost:5433/daily_dev

# Vercel / Preview / Production: DATABASE_URL kommt aus dem Dashboard (z. B. Neon-Integration),
# nicht aus dieser Datei. Lokal immer Docker-URL oben nutzen.
# Migrationen gegen Neon (einmalig nach Schema-Änderung): DATABASE_URL=<neon-url> pnpm prisma migrate deploy

# Next.js
NEXTAUTH_SECRET=change_me_in_production
NEXTAUTH_URL=http://localhost:3000
