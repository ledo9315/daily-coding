# Lokal: Postgres in Docker (Port 5433). Vorher: docker compose up -d db
DATABASE_URL=postgresql://daily_dev:daily_dev_secret@localhost:5433/daily_dev

# Vercel / Preview / Production: DATABASE_URL kommt aus dem Dashboard (z. B. Neon-Integration),
# nicht aus dieser Datei. Lokal immer Docker-URL oben nutzen.
# Migrationen gegen Neon (einmalig nach Schema-Änderung): DATABASE_URL=<neon-url> pnpm prisma migrate deploy

# Auth.js (NextAuth v5): openssl rand -base64 32
AUTH_SECRET=change_me_in_production_use_openssl_rand_base64_32

# App-URL für Auth (lokal / Production)
NEXTAUTH_URL=http://localhost:3000

# Optional: OAuth providers (uncomment and fill to enable)
# AUTH_GITHUB_ID=your_github_oauth_app_client_id
# AUTH_GITHUB_SECRET=your_github_oauth_app_client_secret

# Optional: Passwort für alle Seed-User (Standard: DailyDev2024!)
# Nach prisma db seed kannst du dich z. B. anmelden mit:
# max.mustermann@company.com + DailyDev2024!
# SEED_DEV_PASSWORD=DailyDev2024!
