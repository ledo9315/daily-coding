# Local: Postgres in Docker (port 5433). Start with: pnpm db:up  (or: docker compose up -d db)
DATABASE_URL=postgresql://daily_dev:daily_dev_secret@localhost:5433/daily_dev

# Vercel / preview / production: DATABASE_URL comes from the dashboard (e.g. the Neon
# integration), not from this file. Locally always use the Docker URL above.
# Migrating against Neon (once per schema change): DATABASE_URL=<neon-url> pnpm prisma migrate deploy

# Auth.js (NextAuth v5): openssl rand -base64 32
AUTH_SECRET=change_me_in_production_use_openssl_rand_base64_32

# App URL used by auth (local / production)
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Outgoing email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Optional: OAuth providers (uncomment and fill to enable)
# GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# NEXT_PUBLIC_GITHUB_ENABLED=true
# NEXT_PUBLIC_GOOGLE_ENABLED=true

# Optional: password for every seeded user (default: DailyDev2024!)
# After prisma db seed you can sign in with, for example:
# max.mustermann@company.com + DailyDev2024!
# SEED_DEV_PASSWORD=DailyDev2024!

# Optional: seeded admin user (defaults to the same password as SEED_DEV_PASSWORD)
# admin@dailydev.local — page /admin/challenges/new (create challenges)
# SEED_ADMIN_PASSWORD=DailyDev2024!

# Code execution: self-hosted Piston (docker compose service "piston", port 2000).
# 1) docker compose up -d piston   2) pnpm piston:install
#    (the Piston index calls the JavaScript package "node"; the container needs access
#    to GitHub pkgs/index)
# Execution is off in tests / NODE_ENV=test; to disable it: CODE_EXECUTION_ENABLED=false
# PISTON_API_URL=http://127.0.0.1:2000
# CODE_EXECUTION_ENABLED=false
