# ─────────────────────────────────────────────────────────────────────────────
# Production environment for Daily Dev.
# Copy the values into your host's env settings (Vercel Project Settings,
# VPS `.env`, etc.). NEVER commit real secrets — this file only documents them.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Postgres) -----------------------------------------------------
# Managed Postgres connection string (e.g. Neon). Use the POOLED connection
# string for the running app. Run migrations once against the DIRECT string:
#   DATABASE_URL="<direct-url>" pnpm prisma migrate deploy
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth.js / NextAuth v5 ---------------------------------------------------
# Canonical name is AUTH_SECRET (NextAuth v5 reads it automatically).
# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32

# Public base URL of the deployed app (no trailing slash). Used by Auth.js and
# baked into the links inside verification / password-reset emails.
NEXTAUTH_URL=https://your-domain.example
APP_URL=https://your-domain.example

# --- Email delivery (Resend) -------------------------------------------------
# API key from https://resend.com. EMAIL_FROM must be on a domain you have
# verified in Resend, otherwise verification/reset mails will not be delivered.
RESEND_API_KEY=re_your_production_key
EMAIL_FROM=noreply@your-domain.example

# Set to "true" to require a verified email before login is allowed.
REQUIRE_EMAIL_VERIFICATION=true

# --- Code execution (Piston) -------------------------------------------------
# Real code execution is ON by default in production. It calls a self-hosted
# Piston instance. Point this at your reachable Piston HTTPS endpoint.
PISTON_API_URL=https://piston.your-domain.example
# Runtimes must be installed on that instance (js/ts/python/php):
#   docker compose up -d piston && pnpm piston:install
#
# To launch WITHOUT code execution first (challenges cannot be solved until a
# Piston instance is wired up), set this instead of PISTON_API_URL:
# CODE_EXECUTION_ENABLED=false

# --- OAuth providers (optional) ----------------------------------------------
# Fill these only if you enable social login. Set the callback/redirect URL in
# the provider console to: https://your-domain.example/api/auth/callback/<provider>
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# These NEXT_PUBLIC_* flags toggle the buttons in the UI (build-time):
# NEXT_PUBLIC_GITHUB_ENABLED=true
# NEXT_PUBLIC_GOOGLE_ENABLED=true

# --- Seed admin (only if you seed production) --------------------------------
# Never ship the default admin. If you run the seed against production, set a
# strong password; otherwise create the admin manually and skip seeding.
# SEED_ADMIN_PASSWORD=use-a-strong-unique-password
